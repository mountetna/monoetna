#!/bin/bash

HOLD_FILE=$(grep -E "^\s+:hold_file:" config.yml | awk '{ print $2 }')
HOLD_URL=$(grep -E "^\s+:hold_url:" config.yml | awk '{ print $2 }')

if [ -f "$HOLD_FILE" ];
then
    hold_time=$(cat $HOLD_FILE)
    curr_time=$(date -u --iso-8601=sec)

    if [[ $curr_time < $hold_time ]];
    then
        exit 0
    fi
fi

if [ "$MAGMA_ENV" == "test" ];
then
    exit 1
fi

# Normal healthcheck: Puma should answer quickly when no hold file is active.
curl -f --connect-timeout 1 --max-time 2 -o /dev/null -X OPTIONS "${HOLD_URL:-http://127.0.0.1:3000}" || exit 1
